{
  "name": "@j4k-oss/askpplx",
  "version": "1.0.0",
  "description": "Minimal Unix-style CLI for querying Perplexity.",
  "keywords": [],
  "homepage": "https://code.j4k.dev/j4k-oss/askpplx#readme",
  "bugs": {
    "url": "https://code.j4k.dev/j4k-oss/askpplx/issues"
  },
  "license": "MIT",
  "author": "Łukasz Jerciński",
  "repository": {
    "type": "git",
    "url": "https://code.j4k.dev/j4k-oss/askpplx.git"
  },
  "bin": {
    "askpplx": "bin/askpplx"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "registry": "https://code.j4k.dev/api/packages/j4k-oss/npm/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/prompts dist/",
    "check:dts": "dts-leaks --own-scope @j4k --own-scope @j4k-oss",
    "clean": "rm -rf dist *.tsbuildinfo",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --check --config .oxfmtrc.json .",
    "fta": "fta-check",
    "knip": "knip",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "prepack": "pnpm run rebuild",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then hooks_path=$(git config --local --get-all core.hooksPath 2>/dev/null && echo .) && [ \"$hooks_path\" = \"$(echo .githooks; echo .)\" ] || git config core.hooksPath .githooks; fi",
    "rebuild": "pnpm run clean && pnpm run build",
    "start": "pnpm -s run rebuild && node --env-file=.env bin/askpplx",
    "test": "vitest run",
    "test:affected": "pnpm run test --since-last-run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.check.json tsconfig.test.json tsconfig.scripts.json tsconfig.build.json --noEmit",
    "validate:packed-packages": "node scripts/validate-packed-packages.ts --packer npm"
  },
  "dependencies": {
    "@ai-sdk/perplexity": "^5.0.35",
    "@commander-js/extra-typings": "^15.0.0",
    "ai": "^7.0.173",
    "commander": "^15.0.0",
    "conf": "^16.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@j4k-oss/dts-leaks": "^1.0.0",
    "@j4k-oss/fta-check": "^1.6.3",
    "@j4k/oxlint-config": "^2.14.13",
    "@j4k/semantic-release-forgejo": "^1.2.6",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "fta-cli": "^3.1.0",
    "knip": "^6.45.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "publint": "^0.3.25",
    "semantic-release": "^26.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.22.0",
  "j4k": {
    "alignDtsCheck": true,
    "alignModuleContract": "esm-only"
  }
}
