{
  "name": "@j4k-oss/askpplx",
  "version": "1.0.0",
  "description": "Minimal Unix-style CLI for querying Perplexity Sonar API.",
  "keywords": [],
  "homepage": "https://code.j4k.dev/j4k-oss/askpplx#readme",
  "bugs": {
    "url": "https://code.j4k.dev/j4k-oss/askpplx/issues"
  },
  "license": "MIT",
  "author": "Łukasz Jerciński",
  "repository": {
    "type": "git",
    "url": "https://code.j4k.dev/j4k-oss/askpplx.git"
  },
  "bin": {
    "askpplx": "bin/askpplx"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "registry": "https://code.j4k.dev/api/packages/j4k-oss/npm/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/prompts dist/",
    "check:dts": "node scripts/check-dts.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --check --config .oxfmtrc.json .",
    "fta": "fta-check",
    "knip": "knip",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "prepack": "pnpm run rebuild",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then hooks_path=$(git config --local --get-all core.hooksPath 2>/dev/null && echo .) && [ \"$hooks_path\" = \"$(echo .githooks; echo .)\" ] || git config core.hooksPath .githooks; fi",
    "rebuild": "pnpm run clean && pnpm run build",
    "start": "pnpm -s run rebuild && node --env-file=.env bin/askpplx",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.check.json tsconfig.test.json tsconfig.scripts.json tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/perplexity": "^3.0.42",
    "@commander-js/extra-typings": "^15.0.0",
    "ai": "^6.0.198",
    "commander": "^15.0.0",
    "conf": "^15.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@j4k-oss/fta-check": "^1.5.10",
    "@j4k/oxlint-config": "2.14.2",
    "@j4k/semantic-release-forgejo": "^1.2.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "fta-cli": "^3.0.0",
    "knip": "^6.16.1",
    "oxfmt": "^0.57.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "semantic-release": "^25.0.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@12.11.2",
  "j4k": {
    "alignDtsCheck": true,
    "alignModuleContract": "esm-only"
  }
}
